POSTGRES_USER=shaka_user
POSTGRES_PASSWORD=replace_with_long_random_hex
POSTGRES_DB=shaka_beach_db
RABBITMQ_DEFAULT_USER=shaka_mq
RABBITMQ_DEFAULT_PASS=replace_with_long_random_hex
# RS256 signing key for auth-service. The API gateway only needs the matching public
# key, which auth-service serves at /.well-known/jwks.json - no shared secret.
# Generate (never commit the result):
#   mkdir -p deployments/secrets
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out deployments/secrets/jwt_private.pem
# Then EITHER point at the file (mounted at /run/secrets, must be readable by the container user)...
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private.pem
# ...OR inline the PEM on one line with literal \n (leave the _FILE variable empty):
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_BASE64_KEY_BODY\n-----END PRIVATE KEY-----"
# Rotation: put the NEW key above, and list the OLD key's public part here (PEM file or
# inline) for at least one access-token lifetime (15m), then remove it.
#   openssl rsa -in old_private.pem -pubout -out deployments/secrets/jwt_previous_public.pem
# JWT_PREVIOUS_PUBLIC_KEYS_FILE=/run/secrets/jwt_previous_public.pem
CORS_ALLOWED_ORIGIN=https://your-project.vercel.app
# Refresh-token cookie (auth-service). Secure must stay true behind HTTPS.
# SameSite=lax only works when the web app and API share a site (e.g. the web app
# proxies /api through its own origin); for a cross-site Vercel -> VM setup use
# "none" (requires Secure=true). See services/auth-service/README.md.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_TOKEN_TTL=168h
# Login/register rate limits in api-gateway (per IP and per email, token bucket).
AUTH_RATE_LIMIT_IP_BURST=20
AUTH_RATE_LIMIT_IP_PER_MINUTE=20
AUTH_RATE_LIMIT_EMAIL_BURST=5
AUTH_RATE_LIMIT_EMAIL_PER_MINUTE=5
# Number of reverse proxies in front of the gateway whose X-Forwarded-For is
# trusted. 1 behind the Caddy edge (cloud); 0 when clients reach the gateway directly.
TRUSTED_PROXY_HOPS=1
PUBLIC_HOSTNAME=YOUR_VM_PUBLIC_IP.nip.io
