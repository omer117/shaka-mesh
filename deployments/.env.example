POSTGRES_USER=shaka_user
POSTGRES_PASSWORD=replace_with_long_random_hex
POSTGRES_DB=shaka_beach_db
RABBITMQ_DEFAULT_USER=shaka_mq
RABBITMQ_DEFAULT_PASS=replace_with_long_random_hex
JWT_SECRET=replace_with_at_least_64_random_hex_characters
CORS_ALLOWED_ORIGIN=https://your-project.vercel.app
# Refresh-token cookie (auth-service). Secure must stay true behind HTTPS.
# SameSite=lax only works when the web app and API share a site (e.g. the web app
# proxies /api through its own origin); for a cross-site Vercel -> VM setup use
# "none" (requires Secure=true). See services/auth-service/README.md.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_TOKEN_TTL=168h
PUBLIC_HOSTNAME=YOUR_VM_PUBLIC_IP.nip.io
