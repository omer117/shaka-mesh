@baseUrl = http://localhost:8000
@api = {{baseUrl}}/api/v1

### Health Check
GET {{baseUrl}}/health

### Register
# @name register
POST {{api}}/auth/register
Content-Type: application/json

{
  "email": "surfer@example.com",
  "password": "correct horse battery"
}

### Login
# @name login
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "surfer@example.com",
  "password": "correct horse battery"
}

@authToken = {{login.response.body.access_token}}

### Get All Beaches
GET {{api}}/beaches

### Nearby Beaches (Tel Aviv Area)
GET {{api}}/beaches/nearby?lat=32.0886&lon=34.7674&radius_km=15

### Create Beach
POST {{api}}/beaches
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Hilton Beach Tel Aviv",
  "latitude": 32.0886,
  "longitude": 34.7674,
  "description": "Consistent reef break"
}

### Shop catalog
GET {{api}}/shop/products

### Get signed-in shopping cart
GET {{api}}/shop/cart
Authorization: Bearer {{authToken}}

### Add one product to the cart
POST {{api}}/shop/cart/items
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "product_id": "board-fish-58",
  "quantity": 1
}

### Simulated checkout (creates a paid demo order; no payment is collected)
POST {{api}}/shop/checkout
Authorization: Bearer {{authToken}}

### Forum categories and discussions
GET {{api}}/forum/categories

###
GET {{api}}/forum/threads

### Create a forum discussion
POST {{api}}/forum/threads
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "category_slug": "local-breaks",
  "title": "Dawn patrol recommendations?",
  "body": "Where are you heading this weekend?"
}